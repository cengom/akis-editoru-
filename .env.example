# Supabase bağlantısı (Supabase panelinde: Project Settings → API).
# Bu dosyayı ".env.local" adıyla kopyalayıp değerleri doldurun. ".env.local" git'e eklenmez.
# Anon / publishable anahtar tarayıcıda görünür olmak üzere tasarlanmıştır; güvenliği
# veritabanındaki Row Level Security kuralları sağlar. "service_role" / secret anahtarı ASLA buraya yazmayın.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
